---
import { datumOpmaak } from '../config';
import Beeld from './Beeld.astro';
import Bronnenmeter from './Bronnenmeter.astro';
import type { Bron } from '../lib/bronnen';

/**
 * Eén artikel in een overzicht.
 *
 * Drie formaten, want een tijdschrift zet niet alles even groot neer. Welk
 * formaat waar komt, bepaalt de pagina die dit component gebruikt; de opmaak
 * per formaat staat in `globaal.css` onder "De stroom".
 *
 *   spread   het openingsstuk: beeld en tekst naast elkaar, om en om gespiegeld
 *   breed    een liggend blok over de halve breedte
 *   kaart    het gewone staande kaartje
 *
 * De hele kaart is klikbaar via een uitgerekt pseudo-element op de titellink.
 * Dat is één link in de toegankelijkheidsboom in plaats van drie die naar
 * dezelfde plek gaan.
 */

interface Props {
  titel: string;
  beschrijving: string;
  url: string;
  publicatiedatum: Date;
  accent?: 'roze' | 'paars' | 'perzik' | 'mint';
  affiliate?: boolean;
  /** Het kapitalenlabel boven de kop, bijvoorbeeld "Wat zit erin?". */
  rubriek?: string;
  formaat?: 'spread' | 'breed' | 'kaart';
  afbeelding: ImageMetadata;
  alt: string;
  /** Voedt de bronnenmeter onder de kaart. */
  bronnen?: readonly Bron[];
  /** Alleen waar voor het eerste beeld op een pagina. */
  eerst?: boolean;
}

const {
  titel,
  beschrijving,
  url,
  publicatiedatum,
  accent = 'roze',
  affiliate = false,
  rubriek,
  formaat = 'kaart',
  afbeelding,
  alt,
  bronnen = [],
  eerst = false,
} = Astro.props;

const beeldVariant = formaat === 'spread' ? 'kop' : 'kaart';
---

<article class={`item item--${formaat} accent-${accent}`}>
  <div class="item__vlak">
    <Beeld afbeelding={afbeelding} alt={alt} variant={beeldVariant} eerst={eerst} />
  </div>

  <div class="item__tekst">
    {rubriek && <span class="rubriek">{rubriek}</span>}
    <h3 class="item__titel"><a href={url}>{titel}</a></h3>
    <p class="item__intro">{beschrijving}</p>
    <div class="item__voet">
      <Bronnenmeter bronnen={bronnen} />
      {
        formaat !== 'kaart' && (
          <time datetime={publicatiedatum.toISOString()}>{datumOpmaak.format(publicatiedatum)}</time>
        )
      }
      {affiliate && <span class="etiket">advertentie</span>}
    </div>
  </div>
</article>
