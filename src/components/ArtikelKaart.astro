---
import { datumOpmaak } from '../config';
import ArtikelBeeld from './ArtikelBeeld.astro';
import type { Motief } from './ArtikelBeeld.astro';

interface Props {
  titel: string;
  beschrijving: string;
  url: string;
  publicatiedatum: Date;
  accent?: 'roze' | 'paars' | 'perzik' | 'mint';
  affiliate?: boolean;
  /** Overschrijft de illustratie; standaard wordt die uit de slug afgeleid. */
  motief?: Motief;
  /** Het kapitalenlabel boven de kop, bijvoorbeeld "Skincare". */
  rubriek?: string;
  /** Groot uitgelicht formaat voor het eerste artikel op een overzicht. */
  groot?: boolean;
}

const {
  titel,
  beschrijving,
  url,
  publicatiedatum,
  accent = 'roze',
  affiliate = false,
  motief,
  rubriek,
  groot = false,
} = Astro.props;

/*
  Het zaad is de slug en niet de volledige URL, zodat de kaart en het artikel
  zelf dezelfde illustratie krijgen — anders ziet een lezer die doorklikt ineens
  iets anders.
*/
const slug = url.split('/').filter(Boolean).pop() ?? titel;
---

{
  groot ? (
    <article class={`uitgelicht accent-${accent}`}>
      <div class="uitgelicht__vlak">
        <ArtikelBeeld motief={motief} accent={accent} zaad={slug} variant="kop" />
      </div>
      <div>
        {rubriek && <span class="rubriek">{rubriek}</span>}
        <h2 class="uitgelicht__titel"><a href={url}>{titel}</a></h2>
        <p class="uitgelicht__intro">{beschrijving}</p>
        <div class="kaart__voet">
          <time datetime={publicatiedatum.toISOString()}>{datumOpmaak.format(publicatiedatum)}</time>
          {affiliate && <span class="etiket">advertentie</span>}
        </div>
      </div>
    </article>
  ) : (
    <li>
      <article class={`kaart accent-${accent}`}>
        <div class="kaart__vlak">
          <ArtikelBeeld motief={motief} accent={accent} zaad={slug} variant="kaart" />
        </div>
        {rubriek && <span class="rubriek">{rubriek}</span>}
        <h3 class="kaart__titel"><a href={url}>{titel}</a></h3>
        <p class="kaart__tekst">{beschrijving}</p>
        <div class="kaart__voet">
          <time datetime={publicatiedatum.toISOString()}>{datumOpmaak.format(publicatiedatum)}</time>
          {affiliate && <span class="etiket">advertentie</span>}
        </div>
      </article>
    </li>
  )
}
