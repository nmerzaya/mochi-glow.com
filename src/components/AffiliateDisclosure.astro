---
import { disclosureTekst } from '../config';

/**
 * Reclame-disclosure.
 *
 * Wordt door `ArtikelLayout.astro` automatisch bovenaan geplaatst zodra
 * `affiliate: true` in de frontmatter staat, een auteur kan dit dus niet
 * vergeten, wat precies de bedoeling is van de eis uit CLAUDE.md.
 *
 * De tekst staat vóór de eerste alinea van het artikel en niet in een voetnoot,
 * conform de aangescherpte Reclamecode Social Media & Influencer Marketing
 * (RSM) per 1 juli 2026.
 */
---

<aside class="melding melding--disclosure">
  <p><strong>Advertentie-informatie.</strong> {disclosureTekst}</p>
</aside>
