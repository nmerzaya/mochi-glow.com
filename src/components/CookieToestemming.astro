---
import { advertentiesActief, ga4MeetID } from '../config';

/**
 * Cookietoestemming via Klaro (BSD-3-Clause, zelfgehost, geen CDN, geen externe
 * verbinding voor de banner zelf).
 *
 * Drie bewuste keuzes:
 *
 * 1. Het venster verschijnt alleen als er werkelijk iets te kiezen valt: zodra
 *    `ga4MeetID` gevuld is of `advertentiesActief` aanstaat. Staat allebei uit,
 *    dan laadt deze site geen enkel script dat toestemming vereist en is een
 *    banner misleidend, die wekt de indruk dat er getrackt wordt.
 *
 * 2. `default: false` en `required: false` op elke dienst: niets staat vooraf
 *    aan. Onder de AVG is toestemming pas geldig als ze actief gegeven is, dus
 *    een vooraf aangevinkt hokje telt niet. `mustConsent: false` houdt de site
 *    leesbaar zonder keuze, wie niets kiest, krijgt niets geladen.
 *
 * 3. De weigerknop staat er even prominent bij als de accepteerknop
 *    (`hideDeclineAll: false`). Weigeren moeilijker maken dan accepteren is een
 *    ontwerppatroon dat sinds de DSA expliciet verboden is; zie `onderzoek/09`,
 *    par. 4.6.
 *
 * De scripts staan op `is:inline` en worden vanaf `/klaro/` geserveerd in plaats
 * van geïmporteerd, omdat Astro geïmporteerde scripts ook bundelt wanneer het
 * component niet gerenderd wordt. `scripts/kopieer-klaro.mjs` zet ze klaar.
 *
 * Een dienst hier moet dezelfde naam hebben als het `data-name` op het
 * bijbehorende `type="text/plain"`-script, anders geeft Klaro het nooit vrij.
 */

const diensten = [
  ga4MeetID && {
    name: 'google-analytics',
    title: 'Google Analytics',
    purposes: ['statistieken'],
    description:
      'Meet welke artikelen gelezen worden. Google plaatst hiervoor cookies en verwerkt gegevens over je bezoek, waaronder je IP-adres.',
    default: false,
    required: false,
  },
  advertentiesActief && {
    name: 'adsense',
    title: 'Google AdSense',
    purposes: ['advertenties'],
    description:
      'Toont advertenties. Google kan hiervoor cookies plaatsen en gegevens over je bezoek verwerken.',
    default: false,
    required: false,
  },
].filter(Boolean);

const toon = diensten.length > 0;
---

{
  toon && (
    <>
      <link rel="stylesheet" href="/klaro/klaro.css" />
      <div id="klaro" />

      <script is:inline set:html={`window.klaroConfig = ${JSON.stringify(
        {
          version: 2,
          elementID: 'klaro',
          storageMethod: 'cookie',
          cookieName: 'mochiglow-toestemming',
          cookieExpiresAfterDays: 180,
          privacyPolicy: '/cookiebeleid',
          default: false,
          /*
            Het venster staat midden in het scherm in plaats van als strook
            onderaan. Klaro doet dat met `mustConsent`: dan toont hij de modal
            met een waas erachter, in plaats van de smalle balk.

            Dat mag alleen omdat weigeren hier net zo makkelijk is als
            accepteren (`hideDeclineAll: false`) en de site na weigeren gewoon
            volledig leesbaar blijft. Een venster dat de site pas vrijgeeft ná
            toestemming zou een cookiemuur zijn, en dat is iets anders, en niet
            toegestaan.
          */
          mustConsent: true,
          acceptAll: true,
          hideDeclineAll: false,
          lang: 'nl',
          translations: {
            nl: {
              consentNotice: {
                title: 'Cookies',
                description:
                  'Mochi Glow gebruikt cookies om te meten welke artikelen gelezen worden. Weigeren kan, zonder gevolgen voor het lezen.',
                learnMore: 'Zelf kiezen',
              },
              consentModal: {
                title: 'Eerst even dit 🍡',
                description:
                  'Mochi Glow wil graag weten welke artikelen gelezen worden, meer niet. Hieronder staat per onderdeel wat het doet. Niets staat vooraf aan, en wat je weigert wordt ook echt niet geladen. Nee zeggen mag: je mist er niets door.',
              },
              purposes: {
                statistieken: { title: 'Statistieken' },
                advertenties: { title: 'Advertenties' },
              },
              ok: 'Accepteren',
              decline: 'Weigeren',
              acceptAll: 'Alles accepteren',
              acceptSelected: 'Selectie opslaan',
              save: 'Opslaan',
              close: 'Sluiten',
              service: { disableAll: { title: 'Alles aan of uit' } },
              privacyPolicy: {
                name: 'cookiebeleid',
                text: 'Meer hierover staat in het {privacyPolicy}.',
              },
            },
          },
          services: diensten,
        },
        null,
        0,
      )};`} />

      <script is:inline defer src="/klaro/klaro-no-translations.js" />

      {/*
        De brug tussen Klaro en Google Consent Mode.

        `BasisLayout.astro` zet de toestemming bij het laden op *denied*. Dit
        stukje zet hem om naar *granted* zodra de bezoeker statistieken toestaat,
        en terug naar *denied* als hij zijn keuze intrekt. Zonder deze brug staat
        Consent Mode voor altijd op geweigerd en meet GA4 niets, hoe vaak iemand
        ook op accepteren drukt.

        De koppeling loopt via de toestemmingscookie en niet via de JavaScript
        van Klaro. Dat is een bewuste keuze: de meegeleverde build
        (`klaro-no-translations.js`) zet alleen `window.klaro.__k` neer en heeft
        geen `getManager()`. Een eerdere versie van dit bestand ging daar wél van
        uit en deed daardoor helemaal niets, de banner werkte, maar de meting
        bleef geweigerd. De cookie is de enige afspraak die tussen Klaro-versies
        stabiel blijft.

        Het klikpunt hangt op `document` in de capture-fase, zodat het ook werkt
        voor knoppen die Klaro pas later in de DOM zet.
      */}
      <script is:inline set:html={`
        (function () {
          var NAAM = 'mochiglow-toestemming';

          function keuze() {
            var m = document.cookie.match(new RegExp('(?:^|;\\\\s*)' + NAAM + '=([^;]*)'));
            if (!m) return null;
            try { return JSON.parse(decodeURIComponent(m[1])); } catch (e) { return null; }
          }

          function pas() {
            if (typeof window.gtag !== 'function') return;
            var c = keuze();
            if (!c) return;
            window.gtag('consent', 'update', {
              analytics_storage: c['google-analytics'] ? 'granted' : 'denied'
            });
          }

          /* Terugkerende bezoeker: keuze staat al in de cookie. */
          pas();

          /* Nieuwe keuze: de cookie wordt vlak na de klik geschreven. */
          document.addEventListener('click', function (e) {
            if (e.target && e.target.closest && e.target.closest('#klaro')) {
              setTimeout(pas, 250);
              setTimeout(pas, 1000);
            }
          }, true);
        })();
      `} />
    </>
  )
}
