---
import { advertentiesActief, ga4MeetID } from '../config';

/**
 * Cookietoestemming via Klaro (BSD-3-Clause, zelfgehost — geen CDN, geen externe
 * verbinding voor de banner zelf).
 *
 * Drie bewuste keuzes:
 *
 * 1. Het venster verschijnt alleen als er werkelijk iets te kiezen valt: zodra
 *    `ga4MeetID` gevuld is of `advertentiesActief` aanstaat. Staat allebei uit,
 *    dan laadt deze site geen enkel script dat toestemming vereist en is een
 *    banner misleidend — die wekt de indruk dat er getrackt wordt.
 *
 * 2. `default: false` en `required: false` op elke dienst: niets staat vooraf
 *    aan. Onder de AVG is toestemming pas geldig als ze actief gegeven is, dus
 *    een vooraf aangevinkt hokje telt niet. `mustConsent: false` houdt de site
 *    leesbaar zonder keuze — wie niets kiest, krijgt niets geladen.
 *
 * 3. De weigerknop staat er even prominent bij als de accepteerknop
 *    (`hideDeclineAll: false`). Weigeren moeilijker maken dan accepteren is een
 *    ontwerppatroon dat sinds de DSA expliciet verboden is; zie `onderzoek/09`,
 *    par. 4.6.
 *
 * De scripts staan op `is:inline` en worden vanaf `/klaro/` geserveerd in plaats
 * van geïmporteerd, omdat Astro geïmporteerde scripts ook bundelt wanneer het
 * component niet gerenderd wordt. `scripts/kopieer-klaro.mjs` zet ze klaar.
 *
 * Een dienst hier moet dezelfde naam hebben als het `data-name` op het
 * bijbehorende `type="text/plain"`-script, anders geeft Klaro het nooit vrij.
 */

const diensten = [
  ga4MeetID && {
    name: 'google-analytics',
    title: 'Google Analytics',
    purposes: ['statistieken'],
    description:
      'Meet welke artikelen gelezen worden. Google plaatst hiervoor cookies en verwerkt gegevens over je bezoek, waaronder je IP-adres.',
    default: false,
    required: false,
  },
  advertentiesActief && {
    name: 'adsense',
    title: 'Google AdSense',
    purposes: ['advertenties'],
    description:
      'Toont advertenties. Google kan hiervoor cookies plaatsen en gegevens over je bezoek verwerken.',
    default: false,
    required: false,
  },
].filter(Boolean);

const toon = diensten.length > 0;
---

{
  toon && (
    <>
      <link rel="stylesheet" href="/klaro/klaro.css" />
      <div id="klaro" />

      <script is:inline set:html={`window.klaroConfig = ${JSON.stringify(
        {
          version: 2,
          elementID: 'klaro',
          storageMethod: 'cookie',
          cookieName: 'mochiglow-toestemming',
          cookieExpiresAfterDays: 180,
          privacyPolicy: '/cookiebeleid',
          default: false,
          mustConsent: false,
          acceptAll: true,
          hideDeclineAll: false,
          lang: 'nl',
          translations: {
            nl: {
              consentNotice: {
                title: 'Cookies',
                description:
                  'Mochi Glow gebruikt cookies om te meten welke artikelen gelezen worden. Weigeren kan, zonder gevolgen voor het lezen.',
                learnMore: 'Zelf kiezen',
              },
              consentModal: {
                title: 'Cookies op Mochi Glow',
                description:
                  'Hieronder staat per onderdeel wat het doet. Niets staat vooraf aan; wat je weigert, wordt niet geladen.',
              },
              purposes: {
                statistieken: { title: 'Statistieken' },
                advertenties: { title: 'Advertenties' },
              },
              ok: 'Accepteren',
              decline: 'Weigeren',
              acceptAll: 'Alles accepteren',
              acceptSelected: 'Selectie opslaan',
              save: 'Opslaan',
              close: 'Sluiten',
              service: { disableAll: { title: 'Alles aan of uit' } },
              privacyPolicy: {
                name: 'cookiebeleid',
                text: 'Meer hierover staat in het {privacyPolicy}.',
              },
            },
          },
          services: diensten,
        },
        null,
        0,
      )};`} />

      <script is:inline defer src="/klaro/klaro-no-translations.js" />
    </>
  )
}
