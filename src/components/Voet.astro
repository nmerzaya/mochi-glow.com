---
import { site, voetnavigatie } from '../config';

const jaar = new Date().getFullYear();
---

<footer class="voet">
  <div class="omhulsel">
    <div class="voet__raster">
      {
        Object.entries(voetnavigatie).map(([kop, items]) => (
          <div>
            <h2>{kop}</h2>
            <ul>
              {items.map((item) => (
                <li>
                  <a href={item.pad}>{item.tekst}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="voet__onder">
      <p>
        {site.naam} legt uit wat er in je huidverzorging zit en hoe voeding meespeelt, op basis van
        bronnen. Geen medisch advies, <a href="/redactionele-richtlijnen">zo werken we</a>.
      </p>
      <p>&copy; {jaar} {site.naam}</p>
    </div>
  </div>
</footer>
