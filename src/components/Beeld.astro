---
import { Image } from 'astro:assets';

/**
 * Het beeld bij een artikel.
 *
 * Tot augustus 2026 koos dit component tussen een foto en een zelf gegenereerde
 * SVG-illustratie. Die illustraties zijn weg (zie `onderzoek/07`, par. 4.1): elk
 * artikel heeft nu een echte afbeelding, `afbeelding` is verplicht in het schema,
 * en er is dus niets meer om tussen te kiezen. Wat overblijft is één plek waar de
 * breedtes en `sizes` per gebruikssituatie staan, zodat een telefoon nooit een
 * beeld van vier megapixel binnenhaalt.
 *
 * De alt-tekst komt uit de frontmatter en is daar verplicht. Hier staat geen
 * terugval op een lege string: dat zou een ontbrekende beschrijving stilzwijgend
 * goedkeuren in plaats van hem af te dwingen.
 */

interface Props {
  afbeelding: ImageMetadata;
  alt: string;
  /** Bepaalt de breedtes die Astro uitsnijdt. */
  variant?: 'kaart' | 'kop' | 'breed';
  /** Alleen het beeld bovenaan een pagina hoort met voorrang te laden. */
  eerst?: boolean;
}

const { afbeelding, alt, variant = 'kaart', eerst = false } = Astro.props;

const breedtes = {
  kaart: [320, 480, 640, 960],
  kop: [640, 960, 1440, 1920],
  breed: [960, 1440, 1920, 2048],
}[variant];

const maten = {
  kaart: '(max-width: 60rem) 100vw, 33vw',
  kop: '(max-width: 1360px) 100vw, 1360px',
  breed: '100vw',
}[variant];
---

<Image
  class={`beeld beeld--${variant}`}
  src={afbeelding}
  alt={alt}
  widths={breedtes}
  sizes={maten}
  loading={eerst ? 'eager' : 'lazy'}
  fetchpriority={eerst ? 'high' : 'auto'}
  decoding="async"
/>
