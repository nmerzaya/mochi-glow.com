---
/**
 * Redactionele illustratie bij een artikel.
 *
 * Waarom eigen SVG en geen foto's: dit project koopt geen producten en heeft dus
 * geen eigen fotografie. Stockbeeld van een willekeurig potje suggereert bezit
 * dat er niet is, en generieke AI-beelden presteren slecht in een visuele niche.
 *
 * De vormen zijn abstract en gelaagd, met verlopen in plaats van vlakke vulling.
 * Dat is het verschil tussen iets dat als clipart leest en iets dat als art
 * direction leest. De korrel zit als CSS-laag over het vlak heen (zie
 * `globaal.css`), zodat er per pagina maar één ruisdefinitie nodig is.
 *
 * De illustraties zijn zuiver decoratief en dragen geen informatie die niet ook
 * in de kop staat. Daarom `aria-hidden` en geen alt-tekst.
 */

export type Motief =
  | 'druppel'
  | 'blad'
  | 'korrels'
  | 'golven'
  | 'bloem'
  | 'ringen'
  | 'vlecht'
  | 'kiem';

export const motieven: Motief[] = [
  'druppel',
  'blad',
  'korrels',
  'golven',
  'bloem',
  'ringen',
  'vlecht',
  'kiem',
];

interface Props {
  motief?: Motief;
  accent?: 'roze' | 'paars' | 'perzik' | 'mint';
  /** Bepaalt het motief als er geen is opgegeven, zodat elk artikel altijd beeld heeft. */
  zaad?: string;
  variant?: 'kaart' | 'kop';
}

const { motief, accent = 'roze', zaad = '', variant = 'kaart' } = Astro.props;

/* Stabiele keuze: hetzelfde artikel houdt bij elke build dezelfde illustratie. */
function hash(tekst: string): number {
  let som = 0;
  for (let i = 0; i < tekst.length; i++) som = (som + tekst.charCodeAt(i) * (i + 1)) % 9973;
  return som;
}

const zaadgetal = hash(zaad);
const gekozen = motief ?? motieven[zaadgetal % motieven.length];

/*
  Verloop-definities hebben een unieke id nodig: op een overzichtspagina staan
  tien illustraties in dezelfde HTML, en gelijke id's zouden elkaar overschrijven.
*/
const id = `b${zaadgetal}${gekozen.slice(0, 2)}${variant.slice(0, 1)}`;

/* Kleine variatie in de compositie, zodat niet elke kaart identiek uitgelijnd staat. */
const verschuiving = (zaadgetal % 40) - 20;

const druppel = (cx: number, top: number, hoogte: number, breedte: number) => {
  const onder = top + hoogte;
  return `M${cx} ${top} C${cx + breedte} ${top + hoogte * 0.55}, ${cx + breedte} ${onder - 4}, ${cx} ${onder} C${cx - breedte} ${onder - 4}, ${cx - breedte} ${top + hoogte * 0.55}, ${cx} ${top} Z`;
};

const golf = (y: number) =>
  `M-20 ${y} C60 ${y - 26}, 110 ${y + 26}, 190 ${y} S330 ${y - 26}, 420 ${y - 10}`;

const korrelPunten = [
  [96, 62, 15], [148, 132, 9], [196, 54, 22], [246, 116, 12],
  [292, 72, 17], [332, 138, 8], [366, 82, 11], [128, 100, 6],
  [262, 40, 7], [212, 154, 10],
];

const kiemVormen = [
  [120, 92, 70, 32, -20], [188, 66, 52, 27, 16], [238, 122, 60, 29, -7], [292, 78, 44, 23, 28],
];
---

<svg
  class={`beeld beeld--${variant}`}
  viewBox="0 0 400 200"
  preserveAspectRatio="xMidYMid slice"
  role="presentation"
  aria-hidden="true"
  focusable="false"
  style={`--beeld-vlak: var(--kleur-oppervlak); --beeld-lijn: var(--kleur-${accent});`}
>
  <defs>
    {/* Zachte wolk achter de compositie: geeft diepte zonder een vorm te zijn. */}
    <radialGradient id={`${id}-wash`} cx="30%" cy="20%" r="90%">
      <stop offset="0%" stop-color="var(--beeld-vlak)" stop-opacity="0.85" />
      <stop offset="100%" stop-color="var(--beeld-vlak)" stop-opacity="0" />
    </radialGradient>

    {/* Verloop voor de gevulde vormen: van wit naar bijna-wit, nooit vlak. */}
    <linearGradient id={`${id}-vorm`} x1="0%" y1="0%" x2="60%" y2="100%">
      <stop offset="0%" stop-color="var(--beeld-vlak)" stop-opacity="1" />
      <stop offset="100%" stop-color="var(--beeld-vlak)" stop-opacity="0.62" />
    </linearGradient>

    {/* Verloop voor de accentvormen: doorschijnend, vangt de kleur van het vlak. */}
    <linearGradient id={`${id}-accent`} x1="100%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="var(--beeld-lijn)" stop-opacity="0.34" />
      <stop offset="100%" stop-color="var(--beeld-lijn)" stop-opacity="0.08" />
    </linearGradient>
  </defs>

  <rect width="400" height="200" fill={`url(#${id}-wash)`} />

  <g transform={`translate(${verschuiving} 0)`}>
    {gekozen === 'druppel' && (
      <>
        <path d={druppel(150, 34, 108, 38)} fill={`url(#${id}-vorm)`} />
        <path d={druppel(238, 62, 82, 29)} fill={`url(#${id}-accent)`} />
        <path d={druppel(300, 94, 56, 20)} fill={`url(#${id}-vorm)`} />
        <circle cx="150" cy="124" r="10" fill="var(--beeld-lijn)" opacity="0.28" />
      </>
    )}

    {gekozen === 'blad' && (
      <>
        <ellipse cx="166" cy="106" rx="74" ry="33" transform="rotate(-24 166 106)" fill={`url(#${id}-vorm)`} />
        <ellipse cx="252" cy="86" rx="56" ry="25" transform="rotate(18 252 86)" fill={`url(#${id}-accent)`} />
        <path d="M96 146 C148 120, 200 96, 252 60" fill="none" stroke="var(--beeld-lijn)" stroke-width="2" stroke-linecap="round" opacity="0.45" />
        <path d="M146 120 L132 100 M174 108 L166 86 M202 94 L196 72" fill="none" stroke="var(--beeld-lijn)" stroke-width="1.5" stroke-linecap="round" opacity="0.3" />
      </>
    )}

    {gekozen === 'korrels' && (
      <>
        {korrelPunten.map(([cx, cy, r], i) => (
          <circle
            cx={cx}
            cy={cy}
            r={r}
            fill={i % 3 === 0 ? `url(#${id}-accent)` : `url(#${id}-vorm)`}
          />
        ))}
      </>
    )}

    {gekozen === 'golven' && (
      <>
        <path d={golf(72)} fill="none" stroke={`url(#${id}-vorm)`} stroke-width="22" stroke-linecap="round" />
        <path d={golf(110)} fill="none" stroke="var(--beeld-lijn)" stroke-width="6" stroke-linecap="round" opacity="0.26" />
        <path d={golf(148)} fill="none" stroke={`url(#${id}-vorm)`} stroke-width="14" stroke-linecap="round" />
      </>
    )}

    {gekozen === 'bloem' && (
      <>
        {[0, 45, 90, 135].map((hoek, i) => (
          <ellipse
            cx="200"
            cy="100"
            rx="66"
            ry="24"
            transform={`rotate(${hoek} 200 100)`}
            fill={i % 2 === 0 ? `url(#${id}-vorm)` : `url(#${id}-accent)`}
          />
        ))}
        <circle cx="200" cy="100" r="15" fill="var(--beeld-lijn)" opacity="0.32" />
      </>
    )}

    {gekozen === 'ringen' && (
      <>
        <circle cx="200" cy="100" r="78" fill="none" stroke={`url(#${id}-vorm)`} stroke-width="18" />
        <circle cx="200" cy="100" r="52" fill="none" stroke="var(--beeld-lijn)" stroke-width="3" opacity="0.3" />
        <circle cx="200" cy="100" r="26" fill={`url(#${id}-vorm)`} />
        <circle cx="296" cy="54" r="15" fill={`url(#${id}-accent)`} />
        <circle cx="108" cy="150" r="10" fill={`url(#${id}-accent)`} />
      </>
    )}

    {gekozen === 'vlecht' && (
      <>
        <path d="M-20 152 C90 152, 112 46, 200 46 C288 46, 310 152, 420 152" fill="none" stroke={`url(#${id}-vorm)`} stroke-width="24" stroke-linecap="round" />
        <path d="M-20 46 C90 46, 112 152, 200 152 C288 152, 310 46, 420 46" fill="none" stroke="var(--beeld-lijn)" stroke-width="5" stroke-linecap="round" opacity="0.3" />
        <circle cx="200" cy="99" r="11" fill="var(--beeld-lijn)" opacity="0.36" />
      </>
    )}

    {gekozen === 'kiem' && (
      <>
        {kiemVormen.map(([x, y, b, h, hoek], i) => (
          <rect
            x={x}
            y={y}
            width={b}
            height={h}
            rx={h / 2}
            transform={`rotate(${hoek} ${x + b / 2} ${y + h / 2})`}
            fill={i % 2 === 0 ? `url(#${id}-vorm)` : `url(#${id}-accent)`}
          />
        ))}
        <circle cx="338" cy="66" r="9" fill={`url(#${id}-accent)`} />
        <circle cx="84" cy="142" r="7" fill={`url(#${id}-accent)`} />
      </>
    )}
  </g>
</svg>
