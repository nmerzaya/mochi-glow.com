---
/**
 * De lopende tekstband.
 *
 * Dit is het enige element op de site dat uit zichzelf beweegt, en daarmee het
 * enige dat onder WCAG 2.2 SC 2.2.2 valt: het start automatisch, duurt langer
 * dan vijf seconden en staat naast andere inhoud. Er moet dus een manier zijn
 * om het te stoppen.
 *
 * Waarom dat een echte knop is en niet alleen `prefers-reduced-motion`: de
 * W3C-toelichting bij dat criterium noemt die mediaquery niet als manier om
 * eraan te voldoen (onderzoek/06, DV14-01). Beide zitten er dus in — de
 * mediaquery voor wie systeembreed minder beweging wil, de knop voor de rest.
 *
 * En omdat de knop zonder JavaScript niet werkt, beweegt de band dan ook niet:
 * `data-actief` wordt door het script gezet, en de CSS zet de animatie pas aan
 * als dat attribuut er staat. Liever een stilstaande band dan een bewegende
 * die niemand kan stoppen.
 */

interface Props {
  woorden?: string[];
}

const {
  woorden = ['Geen beloftes', 'Wel bronnen', 'Geen eigen tests', 'Wel de vindplaats erbij'],
} = Astro.props;
---

<div class="band" data-band>
  <div class="band__spoor">
    <div class="band__groep">
      {
        woorden.map((woord) => (
          <>
            <span class="band__woord">{woord}</span>
            <span class="band__stip" aria-hidden="true">
              ◆
            </span>
          </>
        ))
      }
    </div>
    {/* Tweede, identieke groep: die maakt de lus naadloos. Voor een schermlezer is hij een herhaling en dus ruis. */}
    <div class="band__groep" aria-hidden="true">
      {
        woorden.map((woord) => (
          <>
            <span class="band__woord">{woord}</span>
            <span class="band__stip">◆</span>
          </>
        ))
      }
    </div>
  </div>

  <button class="band__pauze" type="button" data-pauze aria-label="Pauzeer de lopende tekst">
    <span aria-hidden="true" data-pauze-teken>❚❚</span>
  </button>
</div>

<script>
  const band = document.querySelector<HTMLElement>('[data-band]');
  const knop = band?.querySelector<HTMLButtonElement>('[data-pauze]');
  const teken = knop?.querySelector<HTMLElement>('[data-pauze-teken]');

  if (band && knop && teken) {
    /* Pas nu mag de band bewegen: vanaf hier is hij ook te stoppen. */
    band.dataset.actief = 'true';

    knop.addEventListener('click', () => {
      const gepauzeerd = band.dataset.gepauzeerd !== 'true';
      band.dataset.gepauzeerd = String(gepauzeerd);
      knop.setAttribute(
        'aria-label',
        gepauzeerd ? 'Laat de lopende tekst weer lopen' : 'Pauzeer de lopende tekst',
      );
      teken.textContent = gepauzeerd ? '▶' : '❚❚';
    });
  }
</script>
