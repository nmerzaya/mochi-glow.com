---
import BasisLayout from './BasisLayout.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import MedischeDisclaimer from '../components/MedischeDisclaimer.astro';
import Bronnenlijst from '../components/Bronnenlijst.astro';
import Bronnenmeter from '../components/Bronnenmeter.astro';
import Beeld from '../components/Beeld.astro';
import Aanmelding from '../components/Aanmelding.astro';
import { site, datumOpmaak, pijlers, mailActief, type PijlerSleutel } from '../config';

interface Bron {
  titel: string;
  url: string;
  type: 'A' | 'B' | 'C';
}

interface Props {
  titel: string;
  beschrijving: string;
  publicatiedatum: Date;
  bijgewerkt?: Date;
  auteur: string;
  affiliate: boolean;
  productType: 'cosmetica' | 'voeding-supplement' | 'geen';
  gezondheidsclaims: boolean;
  bronnen: Bron[];
  tags: string[];
  accent: 'roze' | 'paars' | 'perzik' | 'mint';
  inci?: string;
  pijler: PijlerSleutel;
  afbeelding: ImageMetadata;
  alt: string;
}

const {
  titel,
  beschrijving,
  publicatiedatum,
  bijgewerkt,
  auteur,
  affiliate,
  productType,
  gezondheidsclaims,
  bronnen,
  tags,
  accent,
  inci,
  pijler,
  afbeelding,
  alt,
} = Astro.props;

/*
  Bij voeding en supplementen mogen de bronnen niet klikbaar zijn: de NVWA
  beschouwt een link naar medische of wetenschappelijke informatie op een pagina
  die zo'n product aanprijst zelf als een ontoelaatbare medische claim.
  Zie onderzoek/04-vormgeving-en-eisen.md, par. 4.3.
*/
const bronLinksToegestaan = productType !== 'voeding-supplement';

const { naam: pijlerNaam, pad: pijlerPad } = pijlers[pijler];

const gestructureerdeData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: titel,
  description: beschrijving,
  datePublished: publicatiedatum.toISOString(),
  dateModified: (bijgewerkt ?? publicatiedatum).toISOString(),
  inLanguage: 'nl-NL',
  author: {
    '@type': 'Person',
    name: auteur,
    url: new URL('/over', site.url).href,
  },
  publisher: {
    '@type': 'Organization',
    name: site.naam,
    url: site.url,
  },
  isAccessibleForFree: true,
};
---

<BasisLayout
  titel={titel}
  beschrijving={beschrijving}
  soort="article"
  publicatiedatum={publicatiedatum}
  bijgewerkt={bijgewerkt}
  deelbeeld={afbeelding}
>
  <script type="application/ld+json" set:html={JSON.stringify(gestructureerdeData)} slot="hoofd" />

  {/*
    De leesbalk. Puur decoratief, hij zegt hetzelfde als de scrollbalk ernaast, dus `aria-hidden`, en hij staat buiten het artikel zodat hij niet meeleest in
    de leesvolgorde. De vulling gebeurt in CSS met een scroll()-tijdlijn; zonder
    ondersteuning of bij `prefers-reduced-motion` blijft het een leeg element.
  */}
  <div class="leesbalk" aria-hidden="true"></div>

  <article class="artikel">
    {/*
      Opmaak van een tijdschriftartikel: rubrieklabel, kop, inleiding, dan pas
      het beeld. De reclame-disclosure staat daarna en dus nog altijd direct
      tegen de eerste alinea aan, zoals de RSM vereist.
    */}
    <header class="artikel__kop">
      <a class="rubriek" href={pijlerPad}>{pijlerNaam}</a>
      <h1>{titel}</h1>
      <p class="hero__intro">{beschrijving}</p>

      <div class="artikel__meta">
        <span>
          Door <a href="/over">{auteur}</a>
        </span>
        <span aria-hidden="true">·</span>
        <time datetime={publicatiedatum.toISOString()}>{datumOpmaak.format(publicatiedatum)}</time>
        {
          bijgewerkt && (
            <>
              <span aria-hidden="true">·</span>
              <span>bijgewerkt {datumOpmaak.format(bijgewerkt)}</span>
            </>
          )
        }
        {inci && (
          <>
            <span aria-hidden="true">·</span>
            <span>INCI: {inci}</span>
          </>
        )}
      </div>
    </header>

    <div class={`artikel__beeld accent-${accent}`}>
      <Beeld afbeelding={afbeelding} alt={alt} variant="breed" eerst />
    </div>

    {/*
      De bronnenmeter staat vóór de tekst en niet erna. Een lezer mag weten
      waar dit stuk op steunt voordat hij het leest, niet pas nadat hij
      overtuigd is.
    */}
    <div class="artikel__meter">
      <Bronnenmeter bronnen={bronnen} variant="blok" />
    </div>

    {/* Automatisch, niet handmatig: zo kan de disclosure niet vergeten worden. */}
    {affiliate && <AffiliateDisclosure />}
    {gezondheidsclaims && <MedischeDisclaimer />}

    <div class={`artikel__inhoud accent-${accent}`}>
      <slot />
    </div>

    {
      tags.length > 0 && (
        <p class="artikel__tags">
          {tags.map((tag) => (
            <span class="etiket">{tag}</span>
          ))}
        </p>
      )
    }

    <Bronnenlijst bronnen={bronnen} linksToegestaan={bronLinksToegestaan} />

    <p class="artikel__terug">
      <a class="knop knop--stil" href={pijlerPad}>Meer uit {pijlerNaam}</a>
    </p>
  </article>

  {/*
    Staat na het artikel in de leesvolgorde, en verschijnt pas na tien seconden
    lezen. Alleen hier: op een overzichtspagina of een juridische pagina is er
    niets gelezen om op voort te bouwen.

    Achter `mailActief`, want zonder ingerichte maildienst zou het venster een
    adres vragen dat nergens aankomt.
  */}
  {mailActief && <Aanmelding />}
</BasisLayout>
