---
import { getImage } from 'astro:assets';
import { site, ga4MeetID, pinterestVerificatie } from '../config';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import CookieToestemming from '../components/CookieToestemming.astro';
import '../styles/globaal.css';

interface Props {
  titel: string;
  beschrijving: string;
  /** `article` zet Open Graph op artikelmodus; standaard `website`. */
  soort?: 'website' | 'article';
  publicatiedatum?: Date;
  bijgewerkt?: Date;
  /** Zet `noindex` voor pagina's die niet in de zoekresultaten horen. */
  verbergVoorZoekmachines?: boolean;
  /**
   * Het beeld op de deelkaart. Geef het artikelbeeld mee; ontbreekt het, dan
   * valt de pagina terug op de merkkaart uit `public/`.
   */
  deelbeeld?: ImageMetadata;
}

const {
  titel,
  beschrijving,
  soort = 'website',
  publicatiedatum,
  bijgewerkt,
  verbergVoorZoekmachines = false,
  deelbeeld,
} = Astro.props;

const canoniek = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const volledigeTitel = titel === site.naam ? `${site.naam}, ${site.tagline}` : `${titel} | ${site.naam}`;

/*
  De deelkaart.

  Elke gedeelde link kwam tot nu toe als een lege kaart binnen: er stond geen
  enkele `og:image` op de site. Dat is niet alleen lelijk, `onderzoek/08`
  par. 4.3 laat zien dat zoekverkeer structureel is weggevallen en dat delen en
  terugkeren overblijven als route naar de lezer. Dan is de kaart die iemand in
  WhatsApp of LinkedIn ziet geen detail maar het visitekaartje.

  1200×630 is de maat die de grote platformen aanhouden. `fit: 'cover'` snijdt
  het artikelbeeld daarop bij; zonder beeld valt de pagina terug op de merkkaart
  die `scripts/maak-merkbeeld.mjs` maakt.

  Absolute URL's zijn hier verplicht: een deelkaart wordt door een server elders
  opgehaald, en die kan met een pad dat met een schuine streep begint niets.
*/
const basis = Astro.site ?? new URL(site.url);
const deelkaart = deelbeeld
  ? new URL((await getImage({ src: deelbeeld, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src, basis).href
  : new URL('/og-standaard.jpg', basis).href;

const gestructureerdeData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.naam,
  url: site.url,
  description: site.beschrijving,
  inLanguage: 'nl-NL',
  publisher: {
    '@type': 'Organization',
    name: site.naam,
    url: site.url,
  },
};
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{volledigeTitel}</title>
    <meta name="description" content={beschrijving} />
    <link rel="canonical" href={canoniek} />
    {verbergVoorZoekmachines && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={soort} />
    <meta property="og:site_name" content={site.naam} />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschrijving} />
    <meta property="og:url" content={canoniek} />
    <meta property="og:locale" content="nl_NL" />
    {publicatiedatum && <meta property="article:published_time" content={publicatiedatum.toISOString()} />}
    {bijgewerkt && <meta property="article:modified_time" content={bijgewerkt.toISOString()} />}

    <meta property="og:image" content={deelkaart} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={titel} />
    {/* `summary_large_image` en niet `summary`: anders krijgt een kaart van 1200×630 een postzegel. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={deelkaart} />

    {/*
      Waarmee Pinterest ziet dat dit domein van deze site is. Alleen een
      tekenreeks: er wordt niets geladen en er gaat geen verzoek uit, dus dit
      raakt de invariant "geen externe verzoeken" niet. Zie `src/config.ts`.
    */}
    {pinterestVerificatie && <meta name="p:domain_verify" content={pinterestVerificatie} />}

    <link rel="alternate" type="application/rss+xml" title={site.naam} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/*
      Het merkteken. SVG voor alles wat het aankan, één bestand, elke graad
      scherp, met een PNG ernaast voor de rest. iOS negeert een SVG-icoon
      volledig en heeft de apple-touch-icon nodig.
    */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />

    {/*
      De letters worden van dit domein zelf geserveerd (public/fonts/, opgehaald
      door scripts/haal-letters.mjs). Nog steeds geen enkel extern verzoek: er
      gaat geen IP-adres van een bezoeker naar een derde partij.

      De twee die de eerste schermvulling bepalen, worden voorgeladen. Zonder dit
      begint de browser er pas aan nadat hij de CSS heeft ontleed, en dat is
      precies de vertraging die je als flikkerende tekst ziet. `crossorigin` is
      ook bij dezelfde herkomst verplicht bij lettertypen, laat je het weg, dan
      haalt de browser het bestand een tweede keer op.
    */}
    <link
      rel="preload"
      href="/fonts/fraunces-variabel.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/newsreader-variabel.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="theme-color" content="#f2eff5" />

    <script type="application/ld+json" set:html={JSON.stringify(gestructureerdeData)} />

    {/*
      Google Analytics 4 met Consent Mode v2.

      ── Waarom deze opzet en niet de vorige ────────────────────────────────

      Eerst stonden beide scripts op `type="text/plain"`, zodat Klaro ze pas
      vrijgaf ná toestemming. Privacytechnisch is dat het strengst, maar het
      heeft één praktisch gevolg: Google ziet de tag dan niet. De controle van
      Google zoekt naar een uitvoerbaar gtag-script, en een geblokkeerd script
      is er geen, vandaar de melding "tag niet gevonden", ook al stond hij wel
      degelijk in de HTML.

      Consent Mode v2 is Google's eigen antwoord daarop, en het is de opzet die
      voor Europese sites bedoeld is. De volgorde is wat hem werkbaar maakt:

      1. Eerst wordt `consent default` op *denied* gezet, vóór gtag.js geladen
         wordt. Zolang dat geldt, plaatst Google geen enkele analytics- of
         advertentiecookie en worden er geen identifiers verstuurd.
      2. Dán pas laadt gtag.js. De tag is daarmee zichtbaar en meetbaar voor
         Google's controle.
      3. Zodra de bezoeker in het venster toestemming geeft, zet
         `CookieToestemming.astro` de status om naar *granted* en begint de
         gewone meting.

      ── Wat dit wél verandert, eerlijk gezegd ──────────────────────────────

      Er gaat nu bij het openen van de pagina een verzoek naar
      googletagmanager.com, en daarmee het IP-adres van de bezoeker. Dat gebeurde
      in de vorige opzet niet. Het blijft binnen wat Consent Mode v2 voor de EU
      voorschrijft, geen cookies, geen identifiers, alleen geaggregeerde
      signalen, maar het is een stap minder streng dan volledig blokkeren.

      Wie dat niet wil: `ga4MeetID` in `src/config.ts` op `null` zetten. Dan
      verdwijnt elk extern verzoek weer van de site.
    */}
    {
      ga4MeetID && (
        <>
          <script
            is:inline
            set:html={`
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              gtag('consent', 'default', {
                ad_storage: 'denied',
                ad_user_data: 'denied',
                ad_personalization: 'denied',
                analytics_storage: 'denied',
                functionality_storage: 'denied',
                personalization_storage: 'denied',
                security_storage: 'granted',
                wait_for_update: 500
              });
              gtag('js', new Date());
              gtag('config', '${ga4MeetID}', { anonymize_ip: true });
            `}
          />
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4MeetID}`} />
        </>
      )
    }

    {/* Pagina's kunnen hier extra head-inhoud plaatsen, zoals Article-structuurdata. */}
    <slot name="hoofd" />
  </head>

  <body>
    <a class="sla-over" href="#inhoud">Naar de inhoud</a>
    <Kop />
    <main id="inhoud">
      <div class="omhulsel">
        <slot />
      </div>
    </main>
    <Voet />
    <CookieToestemming />
  </body>
</html>
