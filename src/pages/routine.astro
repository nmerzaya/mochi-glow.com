---
import BasisLayout from '../layouts/BasisLayout.astro';
import Vragenlijst from '../components/Vragenlijst.astro';
import { routinetest } from '../data/routinetest';

const beschrijving =
  'Acht korte vragen over hoe je huid aanvoelt en wat je volhoudt, en daarna een routine in stappen die bij je past, met bij elke stap het artikel dat erover gaat.';
---

<BasisLayout titel="Routinetest" beschrijving={beschrijving}>
  {/*
    Dit staat in de <head> en niet onderaan de pagina, en het is bewust een
    los, inline scriptje: zo weet de opmaak vóór het eerste renderen al of er
    JavaScript is. Zonder deze regel zou een bezoeker eerst het volledige
    routine-overzicht zien, dat een fractie later wegspringt zodra de test het
    overneemt.
  */}
  <script slot="hoofd" is:inline>
    document.documentElement.dataset.js = 'aan';
  </script>

  <div class="hero hero--midden">
    <span class="rubriek">{routinetest.vragen.length} vragen · twee minuten</span>
    <h1>Waar zou jij beginnen?</h1>
    <p class="hero__intro">
      Koreaanse routines hebben de naam eindeloos lang te zijn. Dat hoeven ze niet te zijn, de
      beste routine is die je op een drukke dinsdag nog steeds doet. Acht vragen over hoe je huid
      aanvoelt en waar je zin in hebt, en je weet waar je kunt beginnen.
    </p>
  </div>

  <Vragenlijst
    lijst={routinetest}
    overzichtKop="De vijf stappenplannen"
    overzichtIntro="Hieronder staan ze alle vijf, met per stap wat het is en waarom hij op die plek staat. Werkt JavaScript in je browser, dan staat hierboven een vragenlijst die je naar één ervan brengt."
  />
</BasisLayout>
