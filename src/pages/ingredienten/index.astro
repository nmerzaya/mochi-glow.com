---
import { getCollection } from 'astro:content';
import BasisLayout from '../../layouts/BasisLayout.astro';
import ArtikelKaart from '../../components/ArtikelKaart.astro';

const artikelen = (await getCollection('ingredienten')).sort(
  (a, b) => b.data.publicatiedatum.getTime() - a.data.publicatiedatum.getTime(),
);

const [eerste, ...rest] = artikelen;
---

<BasisLayout
  titel="Skincare"
  beschrijving="De ingrediënten die je op Koreaanse verzorgingsproducten tegenkomt: wat het is, waar het vandaan komt, en wat het onderzoek erover laat zien."
>
  <div class="hero">
    <h1>Skincare</h1>
    <p class="hero__intro">
      Wat is snail mucin nou eigenlijk, en waarom staat niacinamide op zowat elk etiket? Per
      ingrediënt: wat het is, wat er onderzocht is, en waar dat onderzoek ophoudt.
    </p>
  </div>

  {
    !eerste ? (
      <p>Er staan nog geen artikelen in deze rubriek.</p>
    ) : (
      <>
        <ArtikelKaart
          groot
          titel={eerste.data.titel}
          beschrijving={eerste.data.beschrijving}
          url={`/ingredienten/${eerste.id}`}
          publicatiedatum={eerste.data.publicatiedatum}
          accent={eerste.data.accent}
          motief={eerste.data.motief}
          afbeelding={eerste.data.afbeelding}
          alt={eerste.data.alt}
          affiliate={eerste.data.affiliate}
          rubriek="Skincare"
        />

        <ul class="kaartenraster">
          {rest.map((artikel) => (
            <ArtikelKaart
              titel={artikel.data.titel}
              beschrijving={artikel.data.beschrijving}
              url={`/ingredienten/${artikel.id}`}
              publicatiedatum={artikel.data.publicatiedatum}
              accent={artikel.data.accent}
              motief={artikel.data.motief}
              afbeelding={artikel.data.afbeelding}
              alt={artikel.data.alt}
              affiliate={artikel.data.affiliate}
              rubriek="Skincare"
            />
          ))}
        </ul>
      </>
    )
  }
</BasisLayout>
