---
import { getCollection } from 'astro:content';
import BasisLayout from '../layouts/BasisLayout.astro';
import Beeld from '../components/Beeld.astro';
import Stroom from '../components/Stroom.astro';
import Cijferband from '../components/Cijferband.astro';
import { site, pijlers } from '../config';
import { telAlles } from '../lib/bronnen';
import { routinetest } from '../data/routinetest';
import { eetritme } from '../data/eetritme';

const opDatum = (a: { data: { publicatiedatum: Date } }, b: { data: { publicatiedatum: Date } }) =>
  b.data.publicatiedatum.getTime() - a.data.publicatiedatum.getTime();

const alleIngredienten = (await getCollection('ingredienten')).sort(opDatum);
const alleGutSkin = (await getCollection('gut-skin')).sort(opDatum);
const alleBeauty = (await getCollection('beauty')).sort(opDatum);

const gecombineerd = [
  ...alleIngredienten.map((artikel) => ({ artikel, pijler: pijlers.ingredienten })),
  ...alleGutSkin.map((artikel) => ({ artikel, pijler: pijlers['gut-skin'] })),
  ...alleBeauty.map((artikel) => ({ artikel, pijler: pijlers.beauty })),
].sort((a, b) => opDatum(a.artikel, b.artikel));

/* `uitgelicht: true` wint; staat het nergens, dan wint het nieuwste artikel. */
const uitgelicht = gecombineerd.find((item) => item.artikel.data.uitgelicht) ?? gecombineerd[0];

const naarItem = (artikel: (typeof gecombineerd)[number]['artikel'], pijler: (typeof pijlers)[keyof typeof pijlers]) => ({
  ...artikel.data,
  url: `${pijler.pad}/${artikel.id}`,
  rubriek: pijler.naam,
});

const ingredienten = alleIngredienten
  .filter((a) => a.id !== uitgelicht?.artikel.id)
  .slice(0, 5)
  .map((a) => naarItem(a, pijlers.ingredienten));

const gutSkin = alleGutSkin
  .filter((a) => a.id !== uitgelicht?.artikel.id)
  .slice(0, 5)
  .map((a) => naarItem(a, pijlers['gut-skin']));

const beauty = alleBeauty
  .filter((a) => a.id !== uitgelicht?.artikel.id)
  .slice(0, 5)
  .map((a) => naarItem(a, pijlers.beauty));

/*
  De cijfers over de site worden geteld, niet ingevuld. Komt er een artikel bij,
  dan verandert de opening van de homepage vanzelf mee, en kan hij ook nooit
  gunstiger uitvallen dan de bronnenlijsten toestaan.
*/
const totaal = telAlles(gecombineerd.map((item) => item.artikel.data.bronnen ?? []));

const eersteVraag = routinetest.vragen[0];
---

<BasisLayout titel={site.naam} beschrijving={site.beschrijving}>
  {/*
    De opening. Alle informatie staat als echte tekst in de HTML en het contrast
    komt van het verloopvlak, niet van het beeld, de eis uit onderzoek/06,
    par. 4.2: de header moet volledig werken als je het beeld wegdenkt.
  */}
  <section class="opening">
    <div class="opening__woord">
      <p class="rubriek">
        {gecombineerd.length} artikelen · {totaal.totaal} bronnen · 2 tests
      </p>
      <h1 class="opening__kop">Weten wat er <em>in je potje</em> zit.</h1>
      <p class="opening__intro">
        Koreaanse huidverzorging staat vol ingrediënten waar je nog nooit van gehoord hebt. Hier
        lees je wat ze zijn, wat je voeding ermee te maken heeft, en wat er écht over bekend is, met de vindplaats erbij, zodat je het zelf kunt nakijken.
      </p>
      <div class="opening__knoppen">
        <a class="knop" href={pijlers.ingredienten.pad}>Wat zit erin?</a>
        <a class="knop knop--stil" href="/routine">Doe de routinetest</a>
      </div>
    </div>

    {
      uitgelicht && (
        <a
          class={`opening__beeld accent-${uitgelicht.artikel.data.accent}`}
          href={`${uitgelicht.pijler.pad}/${uitgelicht.artikel.id}`}
        >
          <Beeld
            afbeelding={uitgelicht.artikel.data.afbeelding}
            alt={uitgelicht.artikel.data.alt}
            variant="kop"
            eerst
          />
          <span class="opening__bijschrift">
            <span class="rubriek">Nieuw · {uitgelicht.pijler.naam}</span>
            <span class="opening__titel">{uitgelicht.artikel.data.titel}</span>
          </span>
        </a>
      )
    }
  </section>

  <Cijferband
    artikelen={gecombineerd.length}
    bronnen={totaal.totaal}
    aandeelPrimair={totaal.aandeelPrimair}
    ingredienten={alleIngredienten.length}
  />

  <section class="sectie">
    <div class="sectie__kop">
      <h2>{pijlers.ingredienten.naam}</h2>
      <a href={pijlers.ingredienten.pad}>Alle {alleIngredienten.length}</a>
    </div>
    {
      ingredienten.length === 0 ? (
        <p>Binnenkort meer.</p>
      ) : (
        <Stroom items={ingredienten} opening={false} />
      )
    }
  </section>

  {/*
    De twee vragenlijsten, asymmetrisch: de routinetest krijgt de ruimte en toont
    zijn eerste vraag meteen, zodat je hem hier al kunt beginnen. Het eetritme
    staat ernaast als kaart. Twee gelijke blokken naast elkaar zouden ze allebei
    tot widget maken.
  */}
  <section class="tweeluik">
    <div class="tweeluik__hoofd onthul">
      <span class="rubriek">Routinetest · {routinetest.vragen.length} vragen</span>
      <h2>{eersteVraag.vraag}</h2>
      <p>
        Antwoord hier en je slaat de eerste vraag over. Aan het eind krijg je een stappenplan te
        zien, geen productlijst. Er wordt niets opgeslagen en niet om je e-mailadres gevraagd.
      </p>
      <ul class="tweeluik__opties">
        {
          eersteVraag.antwoorden.map((antwoord) => (
            <li>
              <a class="tweeluik__optie" href={`/routine?start=${antwoord.id}`}>
                {antwoord.tekst}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <a class="tweeluik__zij onthul" href="/eetritme">
      <span class="rubriek">Nieuw · {eetritme.vragen.length} vragen</span>
      <h2>Jouw eetritme</h2>
      <p>
        Niet welk type je bent, maar wanneer je eet. Zes vragen over de vorm van je dag, en daarna
        welke voedingsgroepen daarbij passen.
      </p>
      <span class="tweeluik__pijl" aria-hidden="true">→</span>
    </a>
  </section>

  <section class="sectie">
    <div class="sectie__kop">
      <h2>{pijlers['gut-skin'].naam}</h2>
      <a href={pijlers['gut-skin'].pad}>Alle {alleGutSkin.length}</a>
    </div>
    {
      gutSkin.length === 0 ? (
        <p>Binnenkort meer.</p>
      ) : (
        <Stroom items={gutSkin} opening={false} />
      )
    }
  </section>

  <section class="sectie">
    <div class="sectie__kop">
      <h2>{pijlers.beauty.naam}</h2>
      <a href={pijlers.beauty.pad}>Alle {alleBeauty.length}</a>
    </div>
    {
      beauty.length === 0 ? (
        <p>Binnenkort meer.</p>
      ) : (
        <Stroom items={beauty} opening={false} />
      )
    }
  </section>

  <section class="sectie">
    <div class="sectie__kop">
      <h2>Hoe dit werkt</h2>
      <a href="/redactionele-richtlijnen">De werkwijze</a>
    </div>
    <div class="uitleg">
      <p>
        Achter elk ingrediënt zit onderzoek, en dat lees ik voor je door: wat er over gepubliceerd
        is, samengevat in gewoon Nederlands, met erbij hoe sterk de onderbouwing eigenlijk is. De
        gekleurde streep onder elk artikel telt letterlijk de bronnen, groen is origineel onderzoek
        of wetgeving, oranje is vakmedia, rood is een blog.
      </p>
      <p>
        Soms is de eerlijke uitkomst dat er nauwelijks iets bekend is. Dan staat dat er ook. Dat is
        het stuk dat in reclame altijd wegvalt, en meestal het stuk waar je het meest aan hebt.
      </p>
    </div>
  </section>
</BasisLayout>
