---
import { getCollection } from 'astro:content';
import BasisLayout from '../layouts/BasisLayout.astro';
import ArtikelKaart from '../components/ArtikelKaart.astro';
import Hero from '../components/Hero.astro';
import Lopendeband from '../components/Lopendeband.astro';
import { site } from '../config';
import { vragen } from '../data/routinetest';

const opDatum = (a: { data: { publicatiedatum: Date } }, b: { data: { publicatiedatum: Date } }) =>
  b.data.publicatiedatum.getTime() - a.data.publicatiedatum.getTime();

const alleIngredienten = (await getCollection('ingredienten')).sort(opDatum);
const alleGutSkin = (await getCollection('gut-skin')).sort(opDatum);

/*
  Het uitgelichte artikel is voortaan echt te sturen: staat er ergens
  `uitgelicht: true`, dan wint het nieuwste daarvan. Staat het nergens, dan valt
  de site terug op het nieuwste artikel überhaupt, zodat de plek nooit leeg is.

  Tot deze wijziging deed dat veld niets — het stond in het schema en in de
  CMS-interface, maar werd nergens uitgelezen. Dat was een valstrik voor wie
  later via het CMS iets wil uitlichten.
*/
const gecombineerd = [
  ...alleIngredienten.map((artikel) => ({ artikel, pad: 'ingredienten', rubriek: 'Skincare' })),
  ...alleGutSkin.map((artikel) => ({ artikel, pad: 'gut-skin', rubriek: 'Voeding & huid' })),
].sort((a, b) => opDatum(a.artikel, b.artikel));

const uitgelicht = gecombineerd.find((item) => item.artikel.data.uitgelicht) ?? gecombineerd[0];
const ingredienten = alleIngredienten.filter((a) => a.id !== uitgelicht?.artikel.id).slice(0, 6);
const gutSkin = alleGutSkin.filter((a) => a.id !== uitgelicht?.artikel.id).slice(0, 3);

/* De eerste vraag van de routinetest staat ook op de homepage: wie hier al kiest, begint niet meer bij nul. */
const eersteVraag = vragen[0];
---

<BasisLayout titel={site.naam} beschrijving={site.beschrijving}>
  <Hero />

  <Lopendeband />

  <section class="verleider onthul">
    <div class="verleider__tekst">
      <span class="rubriek">Routinetest · vijf vragen</span>
      <h2>{eersteVraag.vraag}</h2>
      <p>
        Kies hier je antwoord, dan sla je de eerste vraag over. Er wordt niets opgeslagen en er
        wordt niet om een e-mailadres gevraagd.
      </p>
    </div>
    <ul class="verleider__opties">
      {
        eersteVraag.antwoorden.map((antwoord) => (
          <li>
            <a class="verleider__optie" href={`/routine?start=${antwoord.id}`}>
              {antwoord.tekst}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    uitgelicht && (
      <ArtikelKaart
        groot
        titel={uitgelicht.artikel.data.titel}
        beschrijving={uitgelicht.artikel.data.beschrijving}
        url={`/${uitgelicht.pad}/${uitgelicht.artikel.id}`}
        publicatiedatum={uitgelicht.artikel.data.publicatiedatum}
        accent={uitgelicht.artikel.data.accent}
        motief={uitgelicht.artikel.data.motief}
        afbeelding={uitgelicht.artikel.data.afbeelding}
        alt={uitgelicht.artikel.data.alt}
        rubriek={uitgelicht.rubriek}
      />
    )
  }

  <section class="sectie">
    <div class="sectie__kop">
      <h2>Skincare</h2>
      <a href="/ingredienten">Alle ingrediënten</a>
    </div>
    {
      ingredienten.length === 0 ? (
        <p>Binnenkort meer.</p>
      ) : (
        <ul class="kaartenraster">
          {ingredienten.map((artikel) => (
            <ArtikelKaart
              titel={artikel.data.titel}
              beschrijving={artikel.data.beschrijving}
              url={`/ingredienten/${artikel.id}`}
              publicatiedatum={artikel.data.publicatiedatum}
              accent={artikel.data.accent}
              motief={artikel.data.motief}
              afbeelding={artikel.data.afbeelding}
              alt={artikel.data.alt}
              affiliate={artikel.data.affiliate}
              rubriek="Skincare"
            />
          ))}
        </ul>
      )
    }
  </section>

  <section class="sectie">
    <div class="sectie__kop">
      <h2>Voeding &amp; huid</h2>
      <a href="/gut-skin">Alles bekijken</a>
    </div>
    {
      gutSkin.length === 0 ? (
        <p>Binnenkort meer.</p>
      ) : (
        <ul class="kaartenraster">
          {gutSkin.map((artikel) => (
            <ArtikelKaart
              titel={artikel.data.titel}
              beschrijving={artikel.data.beschrijving}
              url={`/gut-skin/${artikel.id}`}
              publicatiedatum={artikel.data.publicatiedatum}
              accent={artikel.data.accent}
              motief={artikel.data.motief}
              afbeelding={artikel.data.afbeelding}
              alt={artikel.data.alt}
              rubriek="Voeding & huid"
            />
          ))}
        </ul>
      )
    }
  </section>

  <section class="sectie">
    <div class="prozapagina" style="text-align: center">
      <span class="rubriek rubriek--stil">De werkwijze</span>
      <h2 style="margin-top: 0">Geen beloftes, wel bronnen</h2>
      <p>
        Elk artikel vat samen wat er gepubliceerd is, met de vindplaats erbij, en zegt erbij waar het
        bewijs dun is. Dat laatste is meestal het stuk dat wegvalt — en juist het stuk waar je iets
        aan hebt.
      </p>
      <p>
        <a class="knop knop--stil" href="/redactionele-richtlijnen">Zo komen deze artikelen tot stand</a>
      </p>
    </div>
  </section>
</BasisLayout>
