---
import { getCollection } from 'astro:content';
import BasisLayout from '../../layouts/BasisLayout.astro';
import Stroom from '../../components/Stroom.astro';
import { pijlers } from '../../config';

const pijler = pijlers['gut-skin'];

const artikelen = (await getCollection('gut-skin')).sort(
  (a, b) => b.data.publicatiedatum.getTime() - a.data.publicatiedatum.getTime(),
);

const items = artikelen.map((artikel) => ({
  ...artikel.data,
  url: `${pijler.pad}/${artikel.id}`,
  rubriek: pijler.naam,
}));
---

<BasisLayout titel={pijler.naam} beschrijving={pijler.intro}>
  <div class="hero">
    <span class="rubriek rubriek--stil">{artikelen.length} artikelen</span>
    <h1>Huid van binnenuit</h1>
    <p class="hero__intro">
      Wat je eet en hoe je huid eraan toe is, hebben met elkaar te maken, alleen veel minder recht
      toe recht aan dan de verpakkingen doen geloven. Hier staat wat daarvan onderbouwd is, en wat
      er wettelijk over gezegd mag worden.
    </p>
  </div>

  {
    items.length === 0 ? (
      <p>Er staan nog geen artikelen in deze rubriek.</p>
    ) : (
      <Stroom items={items} />
    )
  }
</BasisLayout>
